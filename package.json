{
  "name": "ek3d",
  "version": "0.1.1",
  "description": "WebGL-focused, source-first TypeScript port of Three.js with explicit composition",
  "license": "MIT",
  "author": "Ilya Kuzmichev <eliasku.games@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliasku/ek3d.git"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc -b",
    "test": "vp test",
    "dev": "vp dev --host 127.0.0.1",
    "preview": "vp preview --host 127.0.0.1",
    "build": "vp build",
    "docs:llms": "tsx scripts/build-llms.ts",
    "package:check": "tsx scripts/check-package.ts",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "style:check": "tsx scripts/check-style.ts",
    "check": "npm run format:check && npm run style:check && npm run lint && npm run typecheck",
    "verify": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@eliasku/ts-mangle": "^0.2.4",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
