{
  "servers": {
    "oxlint": {
      "command": "node_modules/.bin/vp",
      "args": ["lint", "--lsp"],
      "fileTypes": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"],
      "rootMarkers": ["package.json"],
      "isLinter": true,
      "initOptions": {
        "settings": { "configPath": "./vite.config.ts", "typeAware": true, "fixKind": "safe_fix" }
      }
    },
    "oxfmt": {
      "command": "node_modules/.bin/vp",
      "args": ["fmt", "--lsp"],
      "fileTypes": [
        ".ts",
        ".tsx",
        ".mts",
        ".cts",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".json",
        ".jsonc",
        ".html",
        ".css",
        ".md"
      ],
      "rootMarkers": ["package.json"],
      "isLinter": true,
      "initOptions": {
        "settings": { "fmt.configPath": "./vite.config.ts", "run": "onSave" }
      }
    }
  }
}
